{
  "retailer_id": "tokopedia",
  "retailer_name": "Tokopedia",
  "logo_url": "https://lf-web-assets.tokopedia-static.net/obj/tokopedia-web-sg/arael_v3/0c292173.png",
  "is_mandatory": false,
  "is_dpage": true,
  "schema": [
    {
      "name": "login",
      "type": "email",
      "prompt": "Email"
    },
    {
      "name": "submit",
      "type": "click",
      "prompt": "Sign In",
      "dependsOnFields": "email"
    }
  ],
  "dataTransform": {
    "dataPath": "purchase_history",
    "fieldMappings": [
      {
        "outputKey": "brand",
        "sourcePath": "brand",
        "defaultValue": "Tokopedia"
      },
      {
        "outputKey": "order_date",
        "sourcePath": "payment_date",
        "defaultValue": "N/A",
        "transform": "date"
      },
      {
        "outputKey": "order_total",
        "sourcePath": "total_price",
        "defaultValue": "N/A"
      },
      {
        "outputKey": "order_id",
        "sourcePath": "purchase_detail_url",
        "defaultValue": "N/A"
      },
      {
        "outputKey": "product_names",
        "sourcePath": "products.title",
        "defaultValue": "N/A",
        "convertToArray": true
      },
      {
        "outputKey": "image_urls",
        "sourcePath": "products.imageURL",
        "defaultValue": "N/A",
        "transform": "image",
        "convertToArray": true
      }
    ]
  }
}